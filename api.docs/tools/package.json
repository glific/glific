{
  "name": "glific-bruno-tools",
  "private": true,
  "description": "Checks the Glific Bruno collection against the GraphQL schema",
  "scripts": {
    "schema": "cd ../.. && mix absinthe.schema.json --schema GlificWeb.Schema api.docs/tools/schema.json",
    "validate": "node validate.js ../glific_api --coverage"
  },
  "dependencies": {
    "@usebruno/filestore": "0.14.0",
    "graphql": "16.15.0",
    "js-yaml": "4.3.2"
  }
}
